{
  "name": "tsp-enterprises",
  "productName": "T. S. P Enterprises",
  "description": "Offline Inventory Management & Retail POS Billing System for T. S. P Enterprises",
  "author": "T. S. P Enterprises",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-native.mjs && electron-builder --win",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prepare-native": "node scripts/prepare-native.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "chart.js": "^4.5.0",
    "countup": "^1.8.2",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "exceljs": "^4.4.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jspdf-invoice-template": "^1.4.4",
    "lucide-react": "^1.74.0",
    "nanoid": "^5.1.5",
    "postcss": "^8.5.4",
    "prebuild-install": "^7.1.2",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-countup": "^6.5.3",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.6.2",
    "sweetalert2": "^11.22.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.2.2",
    "uuid": "^11.1.0",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js",
  "build": {
    "productName": "T. S. P Enterprises",
    "appId": "com.tspenterprises.billing",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**",
      "**/node_modules/file-uri-to-path/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "StockMate.${ext}",
      "executableName": "StockMate"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "dist/",
      "dist-electron/",
      "public/icon.png",
      "package.json",
      "!billing.db",
      "!release/"
    ]
  }
}
